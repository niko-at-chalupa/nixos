        "Xiaomi 15 (Pro)",
        "Xiaomi 15 Pro (Pro)",
        "Xiaomi 13 (Pro)",
        "Samsung Galaxy Tab S8 (Pro)",
        "Google Pixel Tablet (Pro)"
    ],
    "mobile-preview.url": "http://localhost:5173",
    "editor.rulers": [
        80
